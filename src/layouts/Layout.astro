---
import { ViewTransitions } from 'astro:transitions';
import Analytics from '@vercel/analytics/astro';
import SearchOverlay from '../components/SearchOverlay.astro';
import Header from '../components/Header.astro';
import '../styles/globals.css';

interface Props {
  title: string;
  description?: string;
  type?: string;
}

const { title, description = 'Copy-ready AI coding prompts for Claude Code, Cursor, Lovable and Jev. Find a prompt, copy it, ship it.', type = 'website' } = Astro.props;
const canonicalUrl = Astro.url.pathname === '/' ? 'https://vibeprompt.online/' : `https://vibeprompt.online${Astro.url.pathname}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="VibePrompt" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://vibeprompt.online/og-image.png" />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://vibeprompt.online/og-image.png" />
    <ViewTransitions />
    <Analytics />
    <script is:inline>
      const theme = localStorage.getItem('theme') || 'light';
      document.documentElement.classList.add(theme);
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground transition-colors duration-300">
    <Header />
    <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <slot />
    </main>
    <footer class="border-t border-border/40 mt-16">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 text-sm text-muted-foreground flex flex-col sm:flex-row items-center justify-between gap-3">
        <p>© 2026 VibePrompt — Copy-ready prompts for AI coding tools.</p>
        <nav class="flex gap-5">
          <a href="/about/" class="hover:text-foreground">About</a>
          <a href="/privacy/" class="hover:text-foreground">Privacy</a>
          <a href="/contact/" class="hover:text-foreground">Contact</a>
        </nav>
      </div>
    </footer>
    <SearchOverlay />
  </body>
</html>
