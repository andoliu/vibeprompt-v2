---
import { Menu, Sparkles } from 'lucide-react';
import ThemeToggle from './ThemeToggle';

const navItems = [
  { href: '/jev-prompts/', label: 'Jev' },
  { href: '/claude-code-prompts/', label: 'Claude Code' },
  { href: '/cursor-prompts/', label: 'Cursor' },
  { href: '/lovable-prompts/', label: 'Lovable' },
  { href: '/v0-prompts/', label: 'v0' },
  { href: '/bolt-prompts/', label: 'Bolt' },
  { href: '/windsurf-prompts/', label: 'Windsurf' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') + '/';
const isActive = (href: string) => currentPath === href;
---

<header class="sticky top-0 z-50 w-full border-b border-border/40 bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60">
  <div class="h-14 px-4 sm:px-6 lg:px-8 flex items-center justify-between max-w-[1800px] mx-auto">
    <div class="flex items-center gap-8">
      <a href="/" class="flex items-center space-x-2 transition-opacity hover:opacity-80 shrink-0">
        <Sparkles className="h-6 w-6 text-primary" />
        <span class="font-bold text-lg">VibePrompt</span>
      </a>

      <nav class="hidden md:flex items-center gap-1">
        {navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              'px-3 py-2 rounded-md text-sm font-medium transition-colors',
              isActive(item.href)
                ? 'text-primary bg-primary/10'
                : 'text-muted-foreground hover:text-foreground hover:bg-accent'
            ]}
          >
            {item.label}
          </a>
        ))}
      </nav>
    </div>

    <div class="flex items-center gap-3">
      <button
        id="search-trigger"
        aria-label="Search prompts"
        class="inline-flex items-center justify-center sm:justify-between rounded-lg text-sm font-medium transition-colors border border-input bg-background shadow-sm hover:bg-accent h-10 w-10 px-0 sm:w-[200px] sm:px-4 lg:w-[260px] text-muted-foreground"
      >
        <span class="flex items-center">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="sm:mr-2 h-4 w-4"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          <span class="hidden sm:inline">Search prompts...</span>
        </span>
        <kbd class="hidden lg:inline-flex h-5 select-none items-center rounded border bg-muted px-1.5 font-mono text-[10px] font-medium text-muted-foreground">⌘K</kbd>
      </button>

      <ThemeToggle client:load />

      <button
        id="mobile-menu-trigger"
        class="inline-flex items-center justify-center rounded-md hover:bg-accent h-9 w-9 md:hidden"
        aria-label="Menu"
      >
        <Menu className="h-5 w-5" />
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden md:hidden border-t border-border">
    <nav class="flex flex-col space-y-1 p-4">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            'px-3 py-2 rounded-md text-sm font-medium transition-colors',
            isActive(item.href)
              ? 'bg-primary/10 text-primary'
              : 'text-muted-foreground hover:bg-accent'
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const mobileTrigger = document.getElementById('mobile-menu-trigger');
  const mobileMenu = document.getElementById('mobile-menu');

  mobileTrigger?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      document.getElementById('search-trigger')?.click();
    }
  });
</script>
