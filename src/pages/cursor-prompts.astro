---
import Layout from '../layouts/Layout.astro';
import PromptList from '../components/PromptList.astro';
import prompts from '../data/prompts.json';

const count = prompts.filter((p) => p.tool === 'cursor').length;
---

<Layout
  title={`Cursor Prompts & Rules: ${count}+ Copy-Ready .cursorrules Templates (2026) | VibePrompt`}
  description="Copy-ready Cursor prompts and .cursorrules templates: frontend and backend project rules, code-review enforcer checklists, and small-commit workflow contracts that keep Cursor on rails."
>
  <nav class="text-sm text-muted-foreground mb-4"><a href="/" class="hover:text-foreground">Home</a> / Cursor Prompts</nav>
  <h1 class="text-3xl sm:text-4xl font-bold mb-4">Cursor Prompts & Rules</h1>
  <p class="text-muted-foreground leading-relaxed mb-4 max-w-3xl">
    With Cursor, the highest-leverage prompt isn't typed in the chat — it's written once in a
    <code class="bg-muted/60 rounded px-1.5 py-0.5 text-sm">.cursorrules</code> file and applied to every request afterwards. The rules below encode the conventions
    a senior developer would enforce in review: typed components and Tailwind-first for frontend, thin routers and strict migrations for Python services,
    a fixed severity-ordered checklist for code review, and a small-commit contract that prevents 40-file mystery PRs.
  </p>
  <p class="text-muted-foreground leading-relaxed mb-8 max-w-3xl">
    See the <a href="/cursor/rules-prompts/" class="text-primary hover:underline">rules &amp; .cursorrules templates</a> scene page for the full set with usage notes.
  </p>
  <PromptList filter={(p) => p.tool === 'cursor'} />
</Layout>
