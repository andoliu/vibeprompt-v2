---
import Layout from '../layouts/Layout.astro';
import PromptList from '../components/PromptList.astro';
import prompts from '../data/prompts.json';

const count = prompts.filter((p) => p.tool === 'lovable').length;
---

<Layout
  title={`Lovable Prompts: ${count}+ Copy-Ready App & Page Prompts (2026) | VibePrompt`}
  description="Copy-ready Lovable prompts: full SaaS landing pages, protected Supabase dashboards, waitlist pages with referral tracking, and pricing pages with monthly/yearly toggles. Paste into Lovable and get a working page."
>
  <nav class="text-sm text-muted-foreground mb-4"><a href="/" class="hover:text-foreground">Home</a> / Lovable Prompts</nav>
  <h1 class="text-3xl sm:text-4xl font-bold mb-4">Lovable Prompts</h1>
  <p class="text-muted-foreground leading-relaxed mb-4 max-w-3xl">
    Lovable builds what you describe — so the difference between a decent build and a throwaway demo is the structure of your prompt. The prompts below
    specify sections, data models and behavior explicitly: landing pages with real copy instead of lorem ipsum, Supabase auth flows with server-side session checks,
    and a waitlist that grows itself with referral positions. Each prompt lists exactly what Lovable should produce, which is how you keep it from improvising.
  </p>
  <p class="text-muted-foreground leading-relaxed mb-8 max-w-3xl">
    Replace every <code class="bg-muted/60 rounded px-1.5 py-0.5 text-sm">&lt;placeholder&gt;</code> before pasting — Lovable takes them literally.
  </p>
  <PromptList filter={(p) => p.tool === 'lovable'} />
</Layout>
