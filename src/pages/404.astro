---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found | VibePrompt">
  <main class="flex min-h-[50vh] items-center justify-center">
    <div class="text-center space-y-4">
      <h1 class="text-6xl font-bold">404</h1>
      <p class="text-xl text-muted-foreground">Page not found</p>
      <a
        href="/"
        class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors bg-primary text-primary-foreground shadow hover:bg-primary/90 h-9 px-4 py-2"
      >
        Back to home
      </a>
    </div>
  </main>
</Layout>
