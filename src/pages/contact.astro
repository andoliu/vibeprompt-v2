---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact | VibePrompt"
  description="Contact VibePrompt: suggest a prompt, report an issue, or say hello."
>
  <nav class="text-sm text-muted-foreground mb-4"><a href="/" class="hover:text-foreground">Home</a> / Contact</nav>
  <h1 class="text-3xl font-bold mb-5">Contact</h1>
  <div class="max-w-3xl space-y-4 text-muted-foreground leading-relaxed">
    <p>
      Found a prompt that saved your session? Wrote one that belongs here? Something broken?
    </p>
    <ul class="list-disc pl-6 space-y-1">
      <li><strong>Suggest a prompt</strong> — send the tool, the prompt and a one-line note on when to use it.</li>
      <li><strong>Report an issue</strong> — include the page URL and what you expected.</li>
    </ul>
    <p>Email: <a href="mailto:hello@vibeprompt.online" class="text-primary hover:underline">hello@vibeprompt.online</a></p>
  </div>
</Layout>
